import numpy as np
import matplotlib.pyplot as plt

# Köbös Bézier-görbe
def cubic_bezier(t, P0, P1, P2, P3):
    return (
        (1 - t)**3 * P0 +
        3 * (1 - t)**2 * t * P1 +
        3 * (1 - t) * t**2 * P2 +
        t**3 * P3
    )

# Pontok
P0 = np.array([0.4, 0.15])
P1 = np.array([0.0, 0.8])
P2 = np.array([1.0, 0.8])
P3 = np.array([0.6, 0.15])

# t értékek
t_values = np.linspace(0, 1, 500)

# Görbe pontjai
curve = np.array([
    cubic_bezier(t, P0, P1, P2, P3)
    for t in t_values
])

# Görbe rajzolása
plt.plot(curve[:,0], curve[:,1], linewidth=3)

# Kontrollpontok
control_x = [P0[0], P1[0], P2[0], P3[0]]
control_y = [P0[1], P1[1], P2[1], P3[1]]

plt.plot(control_x, control_y, 'ro--')

plt.axis('equal')
plt.grid(True)
plt.title("Köbös Bézier-hurok")

plt.show()